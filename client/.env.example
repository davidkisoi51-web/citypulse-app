# Copy this file to .env and fill in your values: cp .env.example .env
# .env is git-ignored. Never commit a real key.

# Ticketmaster "Consumer Key" from https://developer.ticketmaster.com/ (My Apps)
VITE_TICKETMASTER_API_KEY=

# Optional: limit live results to one city when the user hasn't picked one
VITE_DEFAULT_CITY=Nairobi

# Flask API base URL (Phase 2). Defaults to http://localhost:5001/api when not set.
VITE_API_URL=http://localhost:5001/api
# Legacy variable (prefer VITE_API_URL):
# VITE_API_BASE_URL=http://localhost:5001

