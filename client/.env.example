# Flask backend URL. Ticketmaster credentials belong on the server.
VITE_API_URL=http://localhost:5001/api

# Optional default event city
VITE_DEFAULT_CITY=Nairobi

# Optional looping background video for the featured banner on the Events page
# A YouTube or Vimeo link, or a direct .mp4/.webm (full URL or a file in public/).
# Leave empty to show the event photo instead.
VITE_FEATURED_VIDEO=https://youtu.be/zg4LL_W6Bpo?t=120
