# Copy to .env and fill locally. Never commit real credentials.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
FLASK_DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/citypulse_dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_AUTH_STUB=true
DEV_AUTH_USER_ID=1
TICKETMASTER_API_KEY=your_ticketmaster_key
DEFAULT_EVENT_CITY=Nairobi
EVENTS_COUNTRY_CODE=KE
CITYPULSE_TIMEZONE=Africa/Nairobi
FRONTEND_URL=http://localhost:5173
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=CityPulse <noreply@example.com>

# Safaricom Daraja sandbox values (configure only when testing M-PESA)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
