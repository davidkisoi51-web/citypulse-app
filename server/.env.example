# Copy to .env and edit for your local machine. Never commit .env.
FLASK_SECRET_KEY=replace-with-a-long-random-local-secret
FLASK_DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/citypulse_dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Temporary local-only bridge until JWT auth is merged. MUST be false in deployed environments.
DEV_AUTH_STUB=true
DEV_AUTH_USER_ID=1
TICKETMASTER_API_KEY=
